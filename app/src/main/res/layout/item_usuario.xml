<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Fila Superior: Nombre Completo, Usuario y Rol Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIconUser"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/accent_blue_bg"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Icono Usuario"
                    android:src="@drawable/ic_user"
                    app:tint="@color/blue_primary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toStartOf="@id/tvRolUsuario"
                android:layout_toEndOf="@id/cardIconUser"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MARTIN CARRASCO"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUsuarioUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Usuario: MARTIN"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRolUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_box"
                android:backgroundTint="@color/accent_green_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="VENDEDOR"
                android:textColor="@color/security_green"
                android:textSize="11sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border_color" />

        <!-- Fila DNI y RUC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDniUsuario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DNI: 78008056"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRucUsuario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RUC: 10780080546"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Correo y Teléfono -->
        <TextView
            android:id="@+id/tvContactoUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Correo: dmaghimilyc@gmail.com • Tel: 995204159"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Dirección -->
        <TextView
            android:id="@+id/tvDireccionUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Dirección: jr san juan de dios y vía de evitamiento sur"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Fila de Botones de Acciones CRUD: Editar, Clave, Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarUsuario"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Editar"
                android:textAllCaps="false"
                android:textColor="@color/blue_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/blue_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetPasswordUsuario"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Clave"
                android:textAllCaps="false"
                android:textColor="@color/security_green"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/security_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarUsuario"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Eliminar"
                android:textAllCaps="false"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/accent_red" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>